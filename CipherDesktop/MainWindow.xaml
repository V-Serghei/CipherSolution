<Window x:Class="CipherDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CipherSolution Desktop"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0,0,0,6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111827" Padding="24,16">
            <StackPanel>
                <TextBlock Text="CipherSolution"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold" />
                <TextBlock Text="Classical cipher pattern lab plus practical text/file encryption"
                           Foreground="#D1D5DB"
                           FontSize="14"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="20">
            <TabItem Header="Work">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Configuration"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,0,0,16" />

                                <Label Content="Mode" />
                                <ComboBox x:Name="ModeComboBox"
                                          SelectionChanged="ModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Practical" IsSelected="True" />
                                    <ComboBoxItem Content="Factory" />
                                    <ComboBoxItem Content="Builder - Default" />
                                    <ComboBoxItem Content="Builder - Manual" />
                                    <ComboBoxItem Content="Abstract Factory" />
                                </ComboBox>

                                <Label Content="Algorithm" Margin="0,14,0,0" />
                                <ComboBox x:Name="CipherComboBox"
                                          SelectionChanged="CipherComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Vigenere" Tag="vigenere" IsSelected="True" />
                                    <ComboBoxItem Content="Beaufort" Tag="beaufort" />
                                    <ComboBoxItem Content="AutoKey" Tag="autokey" />
                                    <ComboBoxItem Content="RunningKey" Tag="runningkey" />
                                    <ComboBoxItem Content="AES-GCM" Tag="aesgcm" />
                                </ComboBox>

                                <Label x:Name="KeyLabel" Content="Key / Password" Margin="0,14,0,0" />
                                <TextBox x:Name="KeyTextBox"
                                         AcceptsReturn="False"
                                         Text="KEY" />

                                <Label Content="Alphabet variant" Margin="0,14,0,0" />
                                <ComboBox x:Name="AlphabetVariantComboBox">
                                    <ComboBoxItem Content="auto" IsSelected="True" />
                                    <ComboBoxItem Content="eng" />
                                    <ComboBoxItem Content="rus" />
                                    <ComboBoxItem Content="rus+eng" />
                                    <ComboBoxItem Content="eng+num" />
                                    <ComboBoxItem Content="rus+num" />
                                    <ComboBoxItem Content="rus+eng+num" />
                                    <ComboBoxItem Content="eng+sym" />
                                    <ComboBoxItem Content="rus+sym" />
                                    <ComboBoxItem Content="rus+eng+sym" />
                                    <ComboBoxItem Content="eng+num+sym" />
                                    <ComboBoxItem Content="rus+num+sym" />
                                    <ComboBoxItem Content="rus+eng+num+sym" />
                                </ComboBox>

                                <StackPanel x:Name="BuilderOptionsPanel" Visibility="Collapsed">
                                    <Label Content="Salt" Margin="0,14,0,0" />
                                    <TextBox x:Name="SaltTextBox" AcceptsReturn="False" />

                                    <CheckBox x:Name="ErrorLoggingCheckBox"
                                              Content="Enable error logging"
                                              Margin="0,14,0,0" />
                                    <CheckBox x:Name="ProcessLoggingCheckBox"
                                              Content="Enable process logging"
                                              Margin="0,8,0,0" />
                                </StackPanel>

                                <Separator Margin="0,18,0,14" />

                                <TextBlock Text="Detected alphabet"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="DetectedAlphabetTextBlock"
                                           Text="auto"
                                           Foreground="#4B5563"
                                           Margin="0,4,0,0" />

                                <TextBlock Text="Round-trip"
                                           FontWeight="SemiBold"
                                           Margin="0,14,0,0" />
                                <TextBlock x:Name="RoundTripTextBlock"
                                           Text="Not checked"
                                           Foreground="#4B5563"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Input"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,0,0,12" />
                                <TextBox x:Name="InputTextBox"
                                         Grid.Row="1"
                                         FontFamily="Consolas"
                                         FontSize="14" />
                            </Grid>
                        </Border>

                        <WrapPanel Grid.Row="1" Margin="0,14,0,6">
                            <Button Content="Encrypt" Click="EncryptButton_Click" />
                            <Button Content="Decrypt" Click="DecryptButton_Click" />
                            <Button Content="Verify" Click="VerifyButton_Click" />
                            <Button Content="Use Result as Input" Click="UseResultButton_Click" />
                            <Button Content="Swap" Click="SwapButton_Click" />
                            <Button Content="Copy Result" Click="CopyResultButton_Click" />
                            <Button Content="Paste Input" Click="PasteInputButton_Click" />
                            <Button Content="Open TXT" Click="OpenTextFileButton_Click" />
                            <Button Content="Save Result" Click="SaveResultButton_Click" />
                            <Button Content="Clear" Click="ClearButton_Click" />
                        </WrapPanel>

                        <Border Grid.Row="2"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Result"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,0,0,12" />
                                <TextBox x:Name="ResultTextBox"
                                         Grid.Row="1"
                                         FontFamily="Consolas"
                                         FontSize="14"
                                         IsReadOnly="True" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="History">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Repeat Selected" Click="RepeatSelectedHistoryButton_Click" />
                        <Button Content="Copy Output" Click="CopyHistoryOutputButton_Click" />
                        <Button Content="Clear History" Click="ClearHistoryButton_Click" />
                    </WrapPanel>
                    <DataGrid x:Name="HistoryDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="150" />
                            <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="90" />
                            <DataGridTextColumn Header="Algorithm" Binding="{Binding Algorithm}" Width="120" />
                            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="130" />
                            <DataGridTextColumn Header="Alphabet" Binding="{Binding AlphabetVariant}" Width="150" />
                            <DataGridCheckBoxColumn Header="OK" Binding="{Binding RoundTripOk}" Width="50" />
                            <DataGridTextColumn Header="Input" Binding="{Binding Input}" Width="*" />
                            <DataGridTextColumn Header="Output" Binding="{Binding Output}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="About">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="CipherInfoListBox"
                             SelectionChanged="CipherInfoListBox_SelectionChanged">
                        <ListBoxItem Content="Vigenere" IsSelected="True" />
                        <ListBoxItem Content="Beaufort" />
                        <ListBoxItem Content="AutoKey" />
                        <ListBoxItem Content="RunningKey" />
                        <ListBoxItem Content="AES-GCM" />
                        <ListBoxItem Content="Design patterns" />
                    </ListBox>
                    <TextBox x:Name="CipherInfoTextBox"
                             Grid.Column="2"
                             FontSize="14"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="#E5E7EB"
                Padding="20,10">
            <TextBlock x:Name="StatusTextBlock"
                       Text="Ready"
                       Foreground="#374151" />
        </Border>
    </Grid>
</Window>
